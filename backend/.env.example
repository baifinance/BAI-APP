# Copy to .env and fill with real secrets — never commit .env itself
Supabase/Gmail/Groq/Jina/Chroma must be rotated before public deploy
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-64-char-random-string-via-python-secrets-token_urlsafe
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://user:password@host:5432/dbname
FRONTEND_BASE_URL=http://localhost:3000/
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Seconds a notification email may hold a request open (webhooks wait on it).
EMAIL_TIMEOUT=5
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=BAI Finance <no-reply@baifinance.com>
# Notification channels (leave off until VAPID/SMTP are configured).
PUSH_NOTIFICATIONS_ENABLED=False
EMAIL_NOTIFICATIONS_ENABLED=False
# Generate VAPID keys with: vapid --gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:no-reply@baifinance.com
WEB_PUSH_TTL=86400
# Per-user limit for the "send test push" button (raise while debugging).
PUSH_TEST_THROTTLE_RATE=100/hour
NOTIFICATION_EMAIL_BATCH_SIZE=50
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_EMAIL_TOKEN_MAX_AGE=2592000
OTP_SIZE=6
OTP_TTL=180
# AI injection of the client's own profile into the LLM prompt (PII egress)
AI_PROFILE_CONTEXT_ENABLED=True
AI_REDACT_PROFILE_PII=False
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
JINA_API_KEY=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
REDIS_URL=redis://localhost:6379/0
# Shared cache (rate limits). Separate DB index from REDIS_URL.
REDIS_CACHE_URL=redis://localhost:6379/1
ASANA_PROFILE_LOOKUP_ENABLED=True
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=
ASANA_REQUEST_TIMEOUT=10
ASANA_WEBHOOK_SECRET=replace-with-random-32-bytes-hex
# Key for encrypting the stored webhook secret at rest (falls back to SECRET_KEY).
ASANA_SECRET_ENC_KEY=replace-with-random-32-bytes-hex
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Dev: use Cloudflare dummy test keys (docs testing section, always-pass). Prod: dashboard keys, managed mode.
OTP_LOGIN_EXPIRY=120
OTP_VERIFIED_FLAG_TTL=14400
ASANA_WEBHOOK_ENABLED=True
# Enable only while registering the webhook (accepts X-Hook-Secret handshake),
# then set back to False so no one can rotate the signing secret.
ASANA_WEBHOOK_HANDSHAKE_ENABLED=False
# Also required to replace an already-stored webhook secret.
ASANA_WEBHOOK_ALLOW_ROTATION=False
# Ignore webhook events older than this (Asana retries for up to 24 hours).
ASANA_WEBHOOK_MAX_EVENT_AGE_SECONDS=3600
# Keep False in production so Asana is ACKed immediately; tests set it True.
ASANA_WEBHOOK_SYNC=False