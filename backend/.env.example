# Copy to .env and fill with real secrets — never commit .env itself
Supabase/Gmail/Groq/Jina/Chroma must be rotated before public deploy
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-64-char-random-string-via-python-secrets-token_urlsafe
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,agile-deprive-frugality.ngrok-free.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://user:password@host:5432/dbname
FRONTEND_BASE_URL=http://localhost:3000/
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=BAI Finance <no-reply@baifinance.com>
OTP_SIZE=6
OTP_TTL=180
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
JINA_API_KEY=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
REDIS_URL=redis://localhost:6379/0
ASANA_PROFILE_LOOKUP_ENABLED=True
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=
ASANA_REQUEST_TIMEOUT=10
ASANA_WEBHOOK_SECRET=replace-with-random-32-bytes-hex
TURNSTILE_SECRET_KEY=0x4AAAAAAFXD-x7MUOQu2ZKK2Ienc7DxevQ
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFXD-_gfue8FZTRF
# Dev: use Cloudflare dummy test keys (docs testing section, always-pass). Prod: dashboard keys, managed mode.
OTP_LOGIN_EXPIRY=120
OTP_VERIFIED_FLAG_TTL=14400
ASANA_WEBHOOK_ENABLED=True