# Copy to .env and fill with real secrets — never commit .env itself
# Rotation checklist: see /tmp/rotation-note.txt — Supabase/Gmail/Groq/Jina/Chroma must be rotated before public deploy
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-64-char-random-string-via-python-secrets-token_urlsafe
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://user:password@host:5432/dbname
FRONTEND_BASE_URL=http://localhost:3000/
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
OTP_SIZE=6
OTP_TTL=180
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
JINA_API_KEY=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
REDIS_URL=redis://localhost:6379/0
